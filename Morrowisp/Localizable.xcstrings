    },
    "Where to pick up next time": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where to pick up next time"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음에 이어서 시작할 자리"
          }
        }
      }
    },
    "With transition support on, a completed focus session waits for you to choose a break or 10 more minutes in the menu bar. Automatic breaks apply only to skipped focus sessions. Turning it off hides task and reward fields and the choice screen. With automatic starts off, each session waits for you to start it from the menu bar.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With transition support on, a completed focus session waits for you to choose a break or 10 more minutes in the menu bar. Automatic breaks apply only to skipped focus sessions. Turning it off hides task and reward fields and the choice screen. With automatic starts off, each session waits for you to start it from the menu bar."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전환 관리를 켜면, 끝까지 마친 집중은 저절로 넘어가지 않고 메뉴 바에서 휴식 시작이나 10분 연장을 고를 때까지 기다립니다(휴식 자동 시작은 건너뛴 집중에만 적용). 끄면 할 일·보상 칸과 선택 화면이 없어지고 예전처럼 동작합니다. 자동 시작을 끄면 세션이 끝났을 때 대기 상태로 멈추고, 메뉴 바에서 직접 시작할 수 있습니다."
          }
        }
      }
    },
    "Write to daily notes when sessions end": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write to daily notes when sessions end"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세션이 끝나면 데일리 노트에 기록"
          }
        }
      }
    },
